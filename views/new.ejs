<%- include("partials/header.ejs")%>
<div class="container">
<form class="needs-validation" novalidate="" action="/new" method="post">
  <div class="row g-3 mt-5" bis_skin_checked="1">
    <div class="col-12" bis_skin_checked="1">
      <label for="firstName" class="form-label fw-bold">Title</label>
      <input
        type="text"
        class="form-control"
        id="title"
        placeholder="Book Title"
        value=""
        required="Title is required"
        name="title"
      />
      <div class="invalid-feedback" bis_skin_checked="1">
        Valid book title is required.
      </div>
    </div>
    <div class="col-12" bis_skin_checked="1">
      <label for="lastName" class="form-label fw-bold">Note</label>
      <input
        type="text"
        class="form-control"
        id="note"
        placeholder="Book Note"
        value=""
        required=""
        name="note"
      />
      <div class="invalid-feedback" bis_skin_checked="1">
        Book note is required.
      </div>
    </div>
   
   

  <button class="mt-5 w-25 btn btn-primary btn-lg" type="submit">
    Submit
  </button>
</form>
</div>
<%- include("partials/footer.ejs")%>
