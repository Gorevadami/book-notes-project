<%- include("partials/header.ejs")%>

<main>
  <section class="py-5 text-center container">
    <div class="row py-lg-5" >
      <div class="col-lg-6 col-md-8 mx-auto" >
        <h1 class="fw-light">My Books</h1>
        <p class="lead text-body-secondary">
          On this page, I will be rating the books I have read and sharing my
          comments.
        </p>

        <p><a href="/add" class="btn btn-primary my-2">Add New Book</a></p>
      </div>
    </div>
  </section>

  <div class="album py-5 bg-body-tertiary" >
    <div class="container" >
      <div
        class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3"
        >

      <% books.forEach(book => {%>
        
 
        <div class="col" >
          <div class="card h-100 d-flex flex-column shadow-sm" >
        <img
  src="<%= book.cover_url %>"
  class="card-img-top"
  style="height: 500px; object-fit: contain; background-color: #f8f9fa;"
  alt="<%= book.title %>"
>
              
            
            <div class="card-body d-flex flex-column" >
              <h5 ><%=book.title%></h5>
              <p class="card-text">
                <%=book.book_not%>
              </p>
              <div class="d-flex justify-content-between align-items-center mt-auto">
                <div class="btn-group" >
                  <button
                    type="button"
                    class="btn btn-sm btn-outline-secondary"
                  >
                    Delete
                  </button>
                  <button
                    type="button"
                    class="btn btn-sm btn-outline-secondary"
                  >
                    Edit
                  </button>
                </div>
                <small class="text-body-secondary"> <%=book.date%> </small>
              </div>
            </div>
          </div>
        </div>
            <% });%>
      </div>
    </div>
  </div>

  <%- include("partials/footer.ejs")%>
</main>
